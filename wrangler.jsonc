{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krad-tech",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "dist"
  },
  "pages_build_output_dir": "dist",
  "vars": {
    "NODE_VERSION": "22",
    "RENDER_BACKEND_URL": "https://krad-tech.onrender.com"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
