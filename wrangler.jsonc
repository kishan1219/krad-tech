{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krad-tech",
  "main": "dist/_worker.js",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "dist",
    "binding": "SITE_ASSETS"
  },
  "pages_build_output_dir": "dist",
  "vars": {
    "NODE_VERSION": "22",
    "SITE_URL": "https://kradtechnology.com",
    "NEXT_PUBLIC_SITE_URL": "https://kradtechnology.com"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": true
    }
  }
}
