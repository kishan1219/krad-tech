# ==============================================================================
# KRAD Technology - Master Environment Configuration Template
# Populate real values inside Render Dashboard / Cloudflare Settings or local .env
# ==============================================================================

# Node Runtime Environment
NODE_VERSION=22.12.0
NODE_ENV=production

# Supabase PostgreSQL Database & Auth Keys (Configure in Render / Cloudflare dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Site & Contact Configuration
NEXT_PUBLIC_COMPANY_NAME="KRAD Technology"
NEXT_PUBLIC_CONTACT_PHONE="+91 91110 21438"
NEXT_PUBLIC_WHATSAPP_NUMBER="919111021438"
NEXT_PUBLIC_CONTACT_EMAIL="contact@kradtechnology.com"
NEXT_PUBLIC_SITE_URL="https://kradtechnology.com"
SITE_URL="https://kradtechnology.com"

# Admin Dashboard Access
ADMIN_USER="admin"
ADMIN_PASS="your-admin-password"
ADMIN_SECRET_KEY="your-admin-secret-key"
